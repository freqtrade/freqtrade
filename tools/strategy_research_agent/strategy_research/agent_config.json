{
  "agent": {
    "name": "local_strategy_researcher",
    "mode": "research_only",
    "live_trading_allowed": false,
    "may_modify_live_config": false,
    "may_read_private_api_keys": false,
    "may_run_external_code": false
  },
  "workspace": {
    "generated_strategy_dir": "user_data/strategies/research_generated",
    "experiment_dir": "user_data/strategy_research/experiments",
    "report_dir": "user_data/strategy_research/reports",
    "candidate_dir": "user_data/strategy_research/candidates",
    "watchlist_dir": "user_data/strategy_research/watchlist",
    "rejected_dir": "user_data/strategy_research/rejected",
    "source_dir": "user_data/strategy_research/sources",
    "dashboard_dir": "user_data/strategy_research/dashboard"
  },
  "research_scope": {
    "priority_pairs": [
      "BTC/USDT",
      "ETH/USDT",
      "BTC/USDT:USDT",
      "ETH/USDT:USDT"
    ],
    "default_market": "Binance USDT-M futures",
    "allowed_markets": [
      "Binance spot",
      "Binance USDT-M futures"
    ],
    "excluded_markets": [
      "low-liquidity altcoins",
      "meme coins"
    ]
  },
  "analysis": {
    "default_timeframes": [
      "1m",
      "5m",
      "15m",
      "1h",
      "4h"
    ],
    "default_leverage_grid": [
      1,
      3,
      5,
      10,
      20,
      50
    ],
    "required_checks": [
      "backtesting",
      "recursive-analysis",
      "lookahead-analysis"
    ],
    "run_recursive_by_default": false,
    "run_lookahead_by_default": false
  },
  "promotion_policy": {
    "live_requires_manual_approval": true,
    "external_source_max_initial_class": "research_candidate",
    "dryrun_requires_sample_out_check": true,
    "dryrun_requires_no_lookahead": true,
    "dryrun_requires_no_recursive_bias": true
  }
}
