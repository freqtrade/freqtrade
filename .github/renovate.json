{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>freqtrade/renovate-config"
  ],
  "timezone": "Europe/Berlin",
  "constraints": {
    "python": "3.12"
  },
  "constraintsFiltering": "strict",
  "pip_requirements": {
    "managerFilePatterns": ["/(^|/)requirements-freqai-rl\\.txt$/"]
  },
  "schedule": [
    "* 0-5 * * 1"
  ],
  "packageRules": [
    {
      "description": "constraints.python is our minimum supported Python version - don't bump it to the latest Python release.",
      "matchManagers": ["renovate-config"],
      "matchDepTypes": ["tool-constraint"],
      "matchDepNames": ["python"],
      "enabled": false
    },
    {
      "description": "Keep scipy and scipy-stubs updates in their own PR, so both are bumped together.",
      "matchDatasources": ["pypi"],
      "matchPackageNames": ["scipy", "scipy-stubs"],
      "groupName": "Scipy",
      "groupSlug": "scipy"
    },
    {
      "description": "Keep scikit-learn updates in their own PR, so the freqai and hyperopt pins are bumped together.",
      "matchDatasources": ["pypi"],
      "matchPackageNames": ["scikit-learn"],
      "groupName": "Scikit-learn",
      "groupSlug": "scikit-learn"
    },
    {
      "description": "Keep freqai dependencies in their own PR - they can't usually be safely updated together with the rest. scikit-learn is excluded, as it's shared with hyperopt.",
      "matchDatasources": ["pypi"],
      "matchFileNames": ["requirements-freqai.txt", "requirements-freqai-rl.txt"],
      "matchPackageNames": ["!scikit-learn"],
      "groupName": "FreqAI dependencies",
      "groupSlug": "freqai"
    }
  ]
}
