{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>freqtrade/renovate-config"
  ],
  "timezone": "Europe/Berlin",
  "schedule": [
    "* 0-5 * * 1"
  ],
  "packageRules": [
    {
      "description": "Bump scipy and scipy-stubs together.",
      "matchDatasources": ["pypi"],
      "matchPackageNames": ["scipy", "scipy-stubs"],
      "groupName": "scipy",
      "groupSlug": "scipy"
    }
  ]
}
