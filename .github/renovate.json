{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>freqtrade/renovate-config"
  ],
  "timezone": "Europe/Berlin",
  "constraints": {
    "python": ">=3.12"
  },
  "constraintsFiltering": "strict",
  "schedule": [
    "* 0-5 * * 1"
  ],
  "packageRules": [
    {
      "description": "Keep scipy and scipy-stubs updates in their own PR, so both are bumped together.",
      "matchDatasources": ["pypi"],
      "matchPackageNames": ["scipy", "scipy-stubs"],
      "groupName": "scipy",
      "groupSlug": "scipy"
    }
  ]
}
