{
  "$schema": "https://schema.freqtrade.io/schema.json",
  "max_open_trades": 1,
  "stake_currency": "USDT",
  "stake_amount": 100,
  "tradable_balance_ratio": 0.99,
  "fiat_display_currency": "USD",
  "dry_run": true,
  "dry_run_wallet": 1000,
  "cancel_open_orders_on_exit": false,
  "trading_mode": "futures",
  "margin_mode": "isolated",
  "strategy": "LongOnlyFreqAIStrategy",
  "freqaimodel": "LightGBMRegressor",
  "timeframe": "5m",
  "unfilledtimeout": {
    "entry": 10,
    "exit": 10,
    "exit_timeout_count": 0,
    "unit": "minutes"
  },
  "entry_pricing": {
    "price_side": "same",
    "use_order_book": false,
    "price_last_balance": 0.0
  },
  "exit_pricing": {
    "price_side": "same",
    "use_order_book": false
  },
  "exchange": {
    "name": "bybit",
    "key": "",
    "secret": "",
    "ccxt_config": {},
    "ccxt_async_config": {},
    "pair_whitelist": [
      "BTC/USDT:USDT"
    ],
    "pair_blacklist": []
  },
  "pairlists": [
    {
      "method": "StaticPairList"
    }
  ],
  "telegram": {
    "enabled": false,
    "token": "",
    "chat_id": ""
  },
  "bot_name": "bot_factory_phase2_freqai_backtest",
  "initial_state": "stopped",
  "force_entry_enable": false,
  "internals": {
    "process_throttle_secs": 5
  },
  "freqai": {
    "enabled": true,
    "identifier": "phase2_long_only_lightgbm_v1",
    "purge_old_models": 2,
    "save_backtest_models": false,
    "train_period_days": 2,
    "backtest_period_days": 1,
    "live_retrain_hours": 0,
    "activate_tensorboard": false,
    "feature_parameters": {
      "include_timeframes": [
        "5m"
      ],
      "include_corr_pairlist": [],
      "label_period_candles": 12,
      "include_shifted_candles": 1,
      "indicator_max_period_candles": 48,
      "indicator_periods_candles": [
        10,
        20
      ],
      "principal_component_analysis": false,
      "use_SVM_to_remove_outliers": false,
      "use_DBSCAN_to_remove_outliers": false
    },
    "data_split_parameters": {
      "test_size": 0.25,
      "shuffle": false
    },
    "model_training_parameters": {
      "n_estimators": 50,
      "learning_rate": 0.05,
      "num_leaves": 15,
      "max_depth": 4,
      "random_state": 42,
      "verbosity": -1
    }
  }
}
