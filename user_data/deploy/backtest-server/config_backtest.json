{
    "$schema": "https://schema.freqtrade.io/schema.json",
    "max_open_trades": 10,
    "stake_currency": "USDT",
    "stake_amount": 1,
    "tradable_balance_ratio": 0.50,
    "fiat_display_currency": "USD",
    "timeframe": "1h",
    "dry_run": true,
    "dry_run_wallet": 25,
    "trading_mode": "spot",
    "margin_mode": "",
    "entry_pricing": {
        "price_side": "same",
        "use_order_book": true,
        "order_book_top": 1,
        "price_last_balance": 0.0,
        "check_depth_of_market": {
            "enabled": false,
            "bids_to_ask_delta": 1
        }
    },
    "exit_pricing": {
        "price_side": "same",
        "use_order_book": true,
        "order_book_top": 1
    },
    "exchange": {
        "name": "mexc",
        "key": "",
        "secret": "",
        "pair_whitelist": [
            "BTC/USDT",
            "ETH/USDT",
            "SOL/USDT",
            "XRP/USDT",
            "DOGE/USDT",
            "ADA/USDT",
            "SUI/USDT",
            "BNB/USDT",
            "DOT/USDT",
            "AVAX/USDT",
            "LINK/USDT",
            "PEPE/USDT"
        ],
        "pair_blacklist": []
    },
    "pairlists": [
        {"method": "StaticPairList", "allow_inactive": true}
    ],
    "telegram": {
        "enabled": false,
        "token": "x",
        "chat_id": "0"
    },
    "api_server": {
        "enabled": true,
        "listen_ip_address": "0.0.0.0",
        "listen_port": 8080,
        "verbosity": "error",
        "jwt_secret_key": "backtestServerSecureKey2026Random",
        "CORS_origins": ["*"],
        "username": "freqtrader",
        "password": "SuperSecurePassword"
    },
    "bot_name": "TrendRider-Backtest",
    "internals": {
        "process_throttle_secs": 5
    }
}
