            # Формируем детали для логирования
            sell_details = {
                **common_details,
                'condition_1_volume': f"{ob_analysis.get('sell_volume', 0):.8f} > {self.volume_threshold.value:.8f}",
                'condition_2_ratio': f"{sell_ratio:.8f} > {min_ratio:.8f}",
                'condition_3_price': f"{last_row['close']:.8f} < {sell_cluster_price:.8f}",
                'condition_4_volume_compare': f"{ob_analysis.get('sell_volume', 0):.8f} > {ob_analysis.get('buy_volume', 0):.8f}",
                'all_conditions_met': all([sell_volume_condition, volume_ratio_condition, price_condition, volume_comparison])
            }

            # Проверяем все условия для сигнала
            sell_signal = all([
                sell_volume_condition,
                volume_ratio_condition,
                price_condition,
                volume_comparison
            ])

            # Обновляем детали с итоговым сигналом
            sell_details['all_conditions_met'] = sell_signal
            sell_details['final_signal'] = sell_signal

            # Логируем сигнал на продажу с указанием результата
            if sell_signal:
                result = TradeResult.SUCCESS
                reason = "Условия для продажи выполнены"
                details = None
                # Используем цену кластера на покупку (bid) для SELL
                price = sell_price if sell_price is not None else last_row['close']
            else:
                result = TradeResult.REJECTED
                reason = "Условия для продажи не выполнены"
                details = sell_details
                price = last_row['close']

            TradeLogger.log_trade(
                pair=pair,
                trade_type=TradeType.SELL,
                price=price,
                volume=ob_analysis.get('sell_volume', 0),
                result=result,
                reason=reason,
                details=details
            )
            has_logs = True

