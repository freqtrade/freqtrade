            # Проверяем условия для SELL сигнала
            # Получаем цену покупки (bid) из стакана
            sell_price = ob_analysis.get('buy_cluster_price')  # Цена покупки (bid)

            # Условие 1: Объем кластера на продажу > порога
            sell_volume_condition = ob_analysis.get('sell_volume', 0) > self.volume_threshold.value

            # Условие 2: Соотношение объемов > минимального
            sell_ratio = ob_analysis.get('sell_ratio', 0)
            volume_ratio_condition = sell_ratio > min_ratio

            # Условие 3: Текущая цена < цены кластера на продажу
            sell_cluster_price = ob_analysis.get('sell_cluster_price', float('inf'))
            price_condition = last_row['close'] < sell_cluster_price

            # Условие 4: Объем продаж > объема покупок
