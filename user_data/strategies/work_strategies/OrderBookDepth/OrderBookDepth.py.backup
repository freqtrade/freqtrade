        except Exception as e:
            logger.error(f"Ошибка при логировании сигналов для {pair}: {e}")



    def populate_exit_trend(self, dataframe: DataFrame, metadata: dict) -> DataFrame:
        """
        Определение условий выхода из сделки на основе кластерного анализа
        """
        pair = metadata['pair']

        try:
            # Проверяем, есть ли открытые позиции по этой паре
            open_positions = self.position_manager.get_open_positions(pair)
            if not open_positions:
                return dataframe

            # Берем первую открытую позицию
            position = open_positions[0]
            entry_price = position.entry_price
            current_price = dataframe['close'].iloc[-1]

            # Получаем анализ стакана с кластерами
            ob_analysis = self._analyze_orderbook(pair)
            if not ob_analysis:
                return dataframe

            # Получаем информацию о кластерах
            sell_cluster = ob_analysis.get('sell_cluster', {})

            # Рассчитываем текущий профит/убыток
            profit_pct = (current_price - entry_price) / entry_price * 100

            # Условия выхода:
            # 1. Достигнут стоп-лосс
            # 2. Достигнут тейк-профит
            # 3. Появился сильный кластер на продажу
            # 4. Соотношение объемов в пользу продаж
            exit_condition_met = False
            exit_reason = ""

            # 1. Проверка стоп-лосса
            if profit_pct <= -abs(self.stoploss * 100):
                exit_condition_met = True
                exit_reason = f"Стоп-лосс: {profit_pct:.2f}%"
            # 2. Проверка тейк-профита
            elif position.take_profit and current_price >= position.take_profit:
                exit_condition_met = True
                exit_reason = f"Тейк-профит: {profit_pct:.2f}%"
            # 3. Проверка кластера на продажу
            elif (sell_cluster.get('volume', 0) >= self.min_cluster_size and
                  ob_analysis.get('sell_ratio', 0) >= self.min_volume_ratio and
                  abs(current_price - sell_cluster.get('price', 0)) / current_price <= self.price_deviation_threshold):
                exit_condition_met = True
                exit_reason = f"Кластер на продажу: {sell_cluster.get('volume', 0):.4f}"

            if exit_condition_met:
                # Выставляем флаг выхода
                dataframe.loc[
                    (dataframe['volume'] > 0) &  # Объем есть
                    (dataframe['close'] > 0),   # Цена валидна
                    'exit_long'] = 1

                # Логируем выход
                TradeLogger.log_trade(
                    pair=pair,
                    trade_type='sell',
                    price=current_price,
                    volume=sell_cluster.get('volume', 0),
                    signal_value=f"cluster={sell_cluster.get('volume', 0):.4f}/{self.min_cluster_size}",
                    threshold=self.min_volume_ratio,
                    result=TradeResult.REJECTED,  # Это сигнал, а не реальный ордер
                    reason=f"Сигнал на продажу: {exit_reason}"
                )

                # Закрываем позицию в менеджере
                self.position_manager.close_position(
                    position.id,
                    exit_price=current_price,
                    exit_time=datetime.now(timezone.utc)
                )

        except Exception as e:
            logger.error(f"Ошибка в populate_exit_trend для {pair}: {e}")

        return dataframe

        if not CONFIG_FILE.exists():
            logger.warning(f"Файл конфигурации {CONFIG_FILE} не найден")
            return

        try:
            with open(CONFIG_FILE, 'r') as f:
                config = json.load(f)

            # Загружаем список пар из конфига
            if 'exchange' in config and 'pair_whitelist' in config['exchange']:
                self.pair_whitelist = config['exchange']['pair_whitelist']
                logger.info(f"Загружено {len(self.pair_whitelist)} торговых пар из конфигурации")

        except Exception as e:
            logger.error(f"Ошибка при загрузке конфигурации: {e}")

    def get_logs(
        self,
        pair: str = None,
        trade_type: str = None,
        date_from: str = None,
        date_to: str = None,
        result: str = None,
        min_volume: float = None,
        min_price: float = None
    ) -> List[Dict[str, Any]]:
        """
        Получение отфильтрованных логов

        :param pair: Торговая пара
        :param trade_type: Trade type (BUY/SELL/SIGNAL)
        :param date_from: Начальная дата (ГГГГ-ММ-ДД)
        :param date_to: Конечная дата (ГГГГ-ММ-ДД)
        :param result: Результат (УСПЕШНО/ОТКЛОНЕНО/ОТМЕНЕНО)
        :param min_volume: Минимальный объем
        :param min_price: Минимальная цена
        :return: Список записей лога
        """
        try:
            # Импортируем здесь, чтобы избежать циклического импорта
            from .utils.log_analyzer import filter_logs
            return filter_logs(
                log_file=LOG_FILE,
                pair=pair,
                trade_type=trade_type,
                date_from=date_from,
                date_to=date_to,
                result=result,
                min_volume=min_volume,
                min_price=min_price
            )
        except Exception as e:
            logger.error(f"Ошибка при получении логов: {e}")
            return []

    def print_trade_stats(self) -> None:
        """Вывод статистики по сделкам"""
        try:
            logs = self.get_logs()
            if not logs:
                print("Нет данных для анализа")
                return

            total_trades = len(logs)
            buy_trades = len([log for log in logs if log.get('TYPE') == 'BUY'])
            sell_trades = len([log for log in logs if log.get('TYPE') == 'SELL'])
            signals = len([log for log in logs if log.get('TYPE') == 'СИГНАЛ'])

            successful_trades = len([log for log in logs if log.get('RESULT') == 'УСПЕШНО'])
            rejected_trades = len([log for log in logs if log.get('RESULT') == 'ОТКЛОНЕНО'])

            print("\n" + "="*50)
            print(f"{'СТАТИСТИКА ТОРГОВЛИ':^50}")
            print("="*50)
            print(f"Всего записей: {total_trades}")
            print(f"Сигналов: {signals}")
            print(f"Попыток покупки: {buy_trades}")
            print(f"Попыток продажи: {sell_trades}")
            print(f"Успешных сделок: {successful_trades}")
            print(f"Отклоненных сделок: {rejected_trades}")

            if buy_trades > 0 or sell_trades > 0:
                success_rate = (successful_trades / (buy_trades + sell_trades)) * 100
                print(f"\nПроцент успешных сделок: {success_rate:.2f}%")

            print("="*50 + "\n")

        except Exception as e:
            logger.error(f"Ошибка при выводе статистики: {e}")

    # Параметры стратегии
    timeframe = '1m'  # Таймфрейм для анализа

    # Параметры анализа стакана
    order_book_depth = IntParameter(20, 100, default=50, space="buy",
                                  description="Глубина анализа стакана")
    min_cluster_size = DecimalParameter(0.1, 1.0, default=0.3, space="buy",
                                      description="Минимальный размер кластера ликвидности")
    cluster_price_threshold = DecimalParameter(0.001, 0.01, default=0.005, space="buy",
                                             description="Порог цены для объединения кластеров")

    # Параметры анализа объема
    volume_threshold = DecimalParameter(1.0, 5.0, default=2.0, space="buy",
                                      description="Порог объема для подтверждения уровня")
    min_volume_ratio = DecimalParameter(0.5, 2.0, default=1.0, space="buy",
                                      description="Минимальное соотношение объемов покупки/продажи")

    # Параметры управления рисками
    stoploss = -0.02  # Стоплосс 2%
    minimal_roi = {
        "0": 0.05,    # 5% прибыли сразу
        "30": 0.025,  # 2.5% после 30 минут
        "60": 0.015,  # 1.5% после 1 часа
        "120": 0.01   # 1% после 2 часов
    }

    def _find_liquidity_clusters(self, orders: List[tuple], is_buy: bool = True) -> Dict:
        """
        Поиск кластеров ликвидности в стакане
        Args:
            orders: Список ордеров (цена, объем)
        Returns:
            Словарь с информацией о найденных кластерах
        """
        try:
            if not orders:
                return {'price': 0, 'volume': 0, 'orders': []}

            # Получаем значения параметров в зависимости от типа кластера (покупка/продажа)
            if is_buy:
                price_threshold = float(self.buy_cluster_price_threshold.value)
                min_size = float(self.buy_min_cluster_size.value)
            else:
                price_threshold = float(self.sell_cluster_price_threshold.value)
                min_size = float(self.sell_min_cluster_size.value)

            clusters = []
            current_cluster = {
                'price': float(orders[0][0]),
                'volume': float(orders[0][1]),
                'orders': [{'price': float(orders[0][0]), 'volume': float(orders[0][1])}]
            }

            for order in orders[1:]:
                try:
                    price = float(order[0])
                    volume = float(order[1])

                    # Проверяем, относится ли ордер к текущему кластеру
                    price_diff = abs(price - current_cluster['price'])
                    price_ratio = price_diff / current_cluster['price'] if current_cluster['price'] > 0 else float('inf')

                    if price_ratio <= price_threshold:
                        # Обновляем среднюю цену кластера
                        total_volume = current_cluster['volume'] + volume
                        current_cluster['price'] = (current_cluster['price'] * current_cluster['volume'] + price * volume) / total_volume
                        current_cluster['volume'] = total_volume
                        current_cluster['orders'].append({'price': price, 'volume': volume})
                    else:
                        # Сохраняем текущий кластер, если он достаточно большой
                        if current_cluster['volume'] >= min_size:
                            clusters.append(current_cluster)
                        # Начинаем новый кластер
                        current_cluster = {
                            'price': price,
                            'volume': volume,
                            'orders': [{'price': price, 'volume': volume}]
                        }
                except (ValueError, TypeError, IndexError) as e:
                    logger.warning(f"Ошибка при обработке ордера {order}: {e}")
                    continue

            # Добавляем последний кластер, если он достаточно большой
            if current_cluster['volume'] >= min_size:
                clusters.append(current_cluster)

            # Возвращаем самый крупный кластер или пустой словарь, если кластеров нет
            if clusters:
                largest = max(clusters, key=lambda x: x['volume'])
                # Убедимся, что значения имеют правильный тип
                return {
                    'price': float(largest['price']) if largest['price'] is not None else 0.0,
                    'volume': float(largest['volume']) if largest['volume'] is not None else 0.0
                }
            return {'price': 0.0, 'volume': 0.0}

        except Exception as e:
            logger.error(f"Ошибка при поиске кластеров ликвидности: {str(e)}")
            return {'price': 0, 'volume': 0}

    def populate_entry_trend(self, dataframe: DataFrame, metadata: dict) -> DataFrame:
        """
        Определение сигналов на вход в позицию
        """
        try:
            pair = metadata['pair']
            last_row = dataframe.iloc[-1]

            # Условия для входа в длинную позицию
            buy_condition = (
                (last_row['buy_cluster_volume'] > self.volume_threshold.value) and
                (last_row['volume_ratio'] > self.min_volume_ratio.value) and
                (last_row['close'] > last_row['buy_cluster_price']) and
                (last_row['buy_cluster_volume'] > last_row['sell_cluster_volume'])
            )

            # Логируем сигнал на покупку
            TradeLogger.log_trade(
                pair=pair,
                trade_type=TradeType.BUY,
                price=last_row['close'],
                volume=last_row['volume'],
                signal_value=last_row['buy_cluster_volume'],
                threshold=self.volume_threshold.value,
                result=TradeResult.SUCCESS,  # Реальные ордера логируем как УСПЕШНО
                reason="" if buy_condition else "Условия входа не выполнены"
            )

            # Применяем условия к dataframe
            dataframe.loc[
                (
                    (dataframe['buy_cluster_volume'] > self.volume_threshold.value) &
                    (dataframe['volume_ratio'] > self.min_volume_ratio.value) &
                    (dataframe['close'] > dataframe['buy_cluster_price']) &
                    (dataframe['buy_cluster_volume'] > dataframe['sell_cluster_volume'])
                ),
                'enter_long'
            ] = 1

        except Exception as e:
            logger.error(f"Ошибка в populate_entry_trend для пары {pair}: {str(e)}")

        return dataframe


    def _get_exchange(self):
        """
        Безопасное получение объекта биржи с несколькими попытками
        """
        exchange = None
        try:
            # Попытка 1: через self.dp.exchange (стандартный способ в новых версиях Freqtrade)
            if hasattr(self.dp, 'exchange') and self.dp.exchange is not None:
                exchange = self.dp.exchange
            # Попытка 2: через self.exchange (устаревший способ)
            elif hasattr(self, 'exchange') and self.exchange is not None:
                exchange = self.exchange
            # Попытка 3: через self._exchange (если используется внутри класса)
            elif hasattr(self, '_exchange') and self._exchange is not None:
                exchange = self._exchange
            # Попытка 4: через self.dp._exchange (если атрибут защищен)
            elif hasattr(self.dp, '_exchange') and self.dp._exchange is not None:
                exchange = self.dp._exchange

            return exchange

        except Exception as e:
            logger.error(f"Ошибка при получении объекта биржи: {str(e)}")
            return None

    def custom_entry_price(self, pair: str, current_time: datetime, proposed_rate: float,
                          entry_tag: Optional[str], side: str, **kwargs) -> float:
        """
        Настройка цены входа в позицию
        """
        try:
            # Получаем объект биржи
            exchange = self._get_exchange()
            if exchange is None:
                logger.error("Не удалось получить доступ к бирже в custom_entry_price")
                return proposed_rate

            # Получаем текущий стакан
            orderbook = exchange.fetch_l2_order_book(pair, 1)

            if side == 'long':
                # Для длинной позиции ставим ордер чуть выше кластера покупок
                return proposed_rate * 1.001  # На 0.1% выше
            else:
                # Для короткой позиции ставим ордер чуть ниже кластера продаж
                return proposed_rate * 0.999  # На 0.1% ниже

        except Exception as e:
            logger.error(f"Ошибка в custom_entry_price для пары {pair}: {str(e)}")
            return proposed_rate  # Возвращаем предложенную цену в случае ошибки
