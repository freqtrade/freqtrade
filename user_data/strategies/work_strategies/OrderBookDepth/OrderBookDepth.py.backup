# Настройка логирования
def setup_logging():
    # Создаем форматтер
    formatter = logging.Formatter('%(asctime)s | %(name)s | %(levelname)s | %(message)s')

    # Создаем обработчик для файла
    file_handler = logging.FileHandler(LOG_DIR / 'strategy.log', mode='a', encoding='utf-8')
    file_handler.setLevel(logging.INFO)  # Минимальный уровень для файла - INFO
    file_handler.setFormatter(formatter)

    # Создаем обработчик для консоли
    console_handler = logging.StreamHandler()
    console_handler.setLevel(logging.INFO)
    console_handler.setFormatter(formatter)

    # Настраиваем корневой логгер
    root_logger = logging.getLogger()
    root_logger.setLevel(logging.WARNING)  # По умолчанию только WARNING и выше

    # Удаляем все существующие обработчики
    for handler in root_logger.handlers[:]:
        root_logger.removeHandler(handler)

    # Настраиваем логгеры для стратегии и торгового логгера
    loggers = [
        ('OrderBookDepth', logging.INFO),        # Основной логгер стратегии
        ('utils.trade_logger', logging.INFO)    # Логгер для торговых операций
    ]

    # Настраиваем каждый логгер
    loggers_configured = []
    for logger_name, log_level in loggers:
        logger_instance = logging.getLogger(logger_name)
        logger_instance.setLevel(log_level)
        logger_instance.propagate = False  # Отключаем передачу сообщений родительским логгерам

        # Удаляем существующие обработчики
        for handler in logger_instance.handlers[:]:
            logger_instance.removeHandler(handler)

        # Добавляем наши обработчики
        logger_instance.addHandler(file_handler)
        logger_instance.addHandler(console_handler)
        loggers_configured.append(logger_instance)

    # Возвращаем основной логгер стратегии
    return logging.getLogger('OrderBookDepth')

# Инициализируем логгер
logger = setup_logging()

# Константы для торговли
DEFAULT_STOP_LOSS = -0.02  # 2% стоп-лосс по умолчанию
DEFAULT_TAKE_PROFIT = 0.05  # 5% тейк-профит по умолчанию
MAX_OPEN_POSITIONS = 3  # Максимальное количество открытых позиций

class OrderBookDepthStrategy(IStrategy):
    """
    Стратегия на основе анализа глубины стакана.

    Основные принципы работы:
    1. Анализ стакана на предмет возможности BUY
    2. Выставление ордера на покупку при выполнении условий
    3. Сохранение информации о сделке в БД
    4. Анализ стакана для открытых позиций на предмет SELL
    5. Выставление ордера на продажу при выполнении условий

    Логирование:
    - Все сигналы и сделки логируются в файл /user_data/logs/strategy.log
    - Формат логов: TIMESTAMP | PAIR | TYPE | PRICE | VOLUME | SIGNAL=значение/порог | RESULT | REASON
    """

    # Настройки стратегии
    timeframe = '1m'
    minimal_roi = {
        "0": 0.02,     # 2% для быстрого закрытия
        "5": 0.01,    # 1% если не закрылась за 5 минут
        "10": 0.005   # 0.5% если не закрылась за 10 минут
    }
    stoploss = -0.01  # 1% стоп-лосс

    # Параметры стратегии (оптимизируемые)
    # Глубина анализа стакана (количество уровней)
    order_book_depth = IntParameter(20, 100, default=50, space="buy",
                                  description="Глубина анализа стакана")

    # Минимальное соотношение объемов покупки/продажи
    min_volume_ratio = DecimalParameter(0.5, 2.0, default=1.5, space="buy",
                                      description="Минимальное соотношение объемов для входа")

    # Параметры кластерного анализа для покупки
    buy_cluster_price_threshold = DecimalParameter(0.0005, 0.005, default=0.001, space="buy",
                                                description="Порог объединения цен в кластер покупки")

    # Минимальный объем кластера покупки в базовой валюте
    buy_min_cluster_size = DecimalParameter(0.5, 5.0, default=1.0, space="buy",
                                         description="Минимальный объем кластера покупки")

    # Параметры кластерного анализа для продажи
    sell_cluster_price_threshold = DecimalParameter(0.0005, 0.005, default=0.001, space="sell",
                                                 description="Порог объединения цен в кластер продажи")

    # Минимальный объем кластера продажи в базовой валюте
    sell_min_cluster_size = DecimalParameter(0.5, 5.0, default=1.0, space="sell",
                                          description="Минимальный объем кластера продажи")

    # Максимальное отклонение цены от кластера продажи для выхода из позиции
    # (в долях от цены, например 0.002 = 0.2%)
    price_deviation_threshold = DecimalParameter(0.001, 0.01, default=0.002, space="sell",
                                               description="Макс. отклонение цены от кластера продажи для выхода")

    # Параметры управления рисками
    risk_per_trade = 0.02  # 2% риска на сделку
    max_open_positions = 3  # Максимальное количество открытых позиций

    # Кэширование данных
    _orderbook_cache = {}
    _orderbook_cache_time = {}
    _orderbook_cache_ttl = 1  # Время жизни кэша в секундах
    _last_analysis_time = {}

    def __init__(self, config: dict) -> None:
        """Инициализация стратегии"""
        super().__init__(config)
        self.position_manager = PositionManager()
        self._exchange_initialized = False
        self._load_config()

    def _lazy_init_exchange(self) -> None:
        """Ленивая инициализация exchange при первом использовании"""
        if not self._exchange_initialized:
            self._init_exchange()
            self._exchange_initialized = True

    def _init_exchange(self) -> None:
        """Инициализация подключения к бирже"""
        try:
            logger.info("=== НАЧАЛО ИНИЦИАЛИЗАЦИИ EXCHANGE ===")

            # В Freqtrade exchange уже инициализирован и доступен через self.dp._exchange
            # или через self.exchange (в зависимости от версии Freqtrade)
            self.exchange = getattr(self.dp, '_exchange', None) or getattr(self, 'exchange', None)

            if self.exchange is None:
                logger.error("Не удалось получить экземпляр exchange из стратегии")
                logger.info(f"Доступные атрибуты в self: {[attr for attr in dir(self) if not attr.startswith('_')]}")
                if hasattr(self, 'dp'):
                    logger.info(f"Доступные атрибуты в self.dp: {[attr for attr in dir(self.dp) if not attr.startswith('_')]}")
                return

            logger.info(f"Тип exchange: {type(self.exchange).__name__}")

            # Проверяем наличие необходимых методов
            required_methods = ['fetch_l2_order_book']
            for method in required_methods:
                if not hasattr(self.exchange, method):
                    logger.error(f"Метод {method} не найден в exchange")
                    available_methods = [m for m in dir(self.exchange) if not m.startswith('_')]
                    logger.info(f"Доступные методы: {', '.join(available_methods)}")
                    self.exchange = None
                    return
                logger.info(f"Метод {method} доступен")

            logger.info(f"=== УСПЕШНАЯ ИНИЦИАЛИЗАЦИЯ EXCHANGE ===")

        except Exception as e:
            logger.error(f"!!! КРИТИЧЕСКАЯ ОШИБКА ПРИ ИНИЦИАЛИЗАЦИИ EXCHANGE: {e} !!!", exc_info=True)
            self.exchange = None

    def _load_config(self) -> None:
        """Загрузка конфигурации из файла"""
        self.pair_whitelist = []

    def _get_orderbook(self, pair: str) -> Optional[dict]:
        """Получение и кэширование стакана ордеров"""
        current_time = datetime.now(timezone.utc)

        # Проверяем кэш
        if pair in self._orderbook_cache:
            cache_time = self._orderbook_cache_time.get(pair)
            if cache_time and (current_time - cache_time).total_seconds() < self._orderbook_cache_ttl:
                return self._orderbook_cache[pair]

        try:
            if not self.exchange:
                logger.error("Exchange не инициализирован")
                return None

            # Получаем стакан ордеров
            depth = int(self.order_book_depth.value) if hasattr(self.order_book_depth, 'value') else int(self.order_book_depth)
            orderbook = self.exchange.fetch_l2_order_book(
                pair,
                limit=depth
            )

            # Обновляем кэш
            self._orderbook_cache[pair] = orderbook
            self._orderbook_cache_time[pair] = current_time

            return orderbook

        except Exception as e:
            logger.error(f"Ошибка при получении стакана для {pair}: {e}")
            return None

    def _analyze_orderbook(self, pair: str) -> dict:
        """
        Анализ стакана ордеров с использованием кластерного анализа
        Возвращает словарь с информацией о кластерах ликвидности
        """
        try:
            # Ленивая инициализация exchange
            if not hasattr(self, 'exchange') or self.exchange is None:
                self._lazy_init_exchange()

            if not self.exchange:
                logger.error("Exchange не инициализирован для анализа стакана")
                return {}

            logger.debug(f"Получение стакана для {pair}...")
            orderbook = self._get_orderbook(pair)
            if not orderbook:
                logger.warning(f"Не удалось получить стакан для {pair}")
                return {}

            # Проверяем структуру стакана
            if 'bids' not in orderbook or 'asks' not in orderbook:
                logger.error(f"Некорректный формат стакана: {orderbook.keys()}")
                return {}

            bids = orderbook.get('bids', [])
            asks = orderbook.get('asks', [])

            if not bids or not asks:
                logger.warning(f"Пустой стакан для {pair}: bids={len(bids)}, asks={len(asks)}")
                return {}

            # Анализируем кластеры ликвидности с разными параметрами для покупки и продажи
            buy_cluster = self._find_liquidity_clusters(bids, is_buy=True) if bids else {}
            sell_cluster = self._find_liquidity_clusters(asks, is_buy=False) if asks else {}

            # Рассчитываем основные метрики
            try:
                best_bid = float(bids[0][0]) if bids and len(bids[0]) > 0 else 0
                best_ask = float(asks[0][0]) if asks and len(asks[0]) > 0 else 0
                spread = (best_ask - best_bid) / best_bid * 100 if best_bid > 0 else 0
                mid_price = (best_bid + best_ask) / 2

                # Рассчитываем объемы
                buy_volume = sum(float(b[1]) for b in bids if len(b) > 1)
                sell_volume = sum(float(a[1]) for a in asks if len(a) > 1)

                # Рассчитываем соотношения
                buy_ratio = buy_volume / sell_volume if sell_volume > 0 else 0
                sell_ratio = sell_volume / buy_volume if buy_volume > 0 else 0

                # Формируем результаты анализа
                result = {
                    'buy_volume': buy_volume,
                    'sell_volume': sell_volume,
                    'buy_ratio': buy_ratio,
                    'sell_ratio': sell_ratio,
                    'timestamp': datetime.now(timezone.utc).timestamp(),
                    'spread': spread,
                    'buy_details': {
                        'condition_1_volume': f"buy_volume={buy_volume:.8f} > volume_threshold={float(self.volume_threshold.value):.8f}",
                        'condition_2_ratio': f"buy_ratio={buy_ratio:.8f} > min_volume_ratio={float(self.min_volume_ratio.value):.8f}",
                        'condition_3_price': f"close_price > buy_cluster_price",
                        'condition_4_volume_compare': f"buy_volume={buy_volume:.8f} > sell_volume={sell_volume:.8f}",
                        'final_signal': False
                    },
                    'sell_details': {
                        'condition_1_volume': f"sell_volume={sell_volume:.8f} > volume_threshold={float(self.volume_threshold.value):.8f}",
                        'condition_2_ratio': f"sell_ratio={sell_ratio:.8f} > min_volume_ratio={float(self.min_volume_ratio.value):.8f}",
                        'condition_3_price': f"close_price < sell_cluster_price",
                        'condition_4_volume_compare': f"sell_volume={sell_volume:.8f} > buy_volume={buy_volume:.8f}",
                        'final_signal': False
                    }
                }

                # Добавляем кластерные данные (с префиксом ob_ и без)
                if buy_cluster:
                    buy_price = buy_cluster.get('price', 0)
                    buy_volume = buy_cluster.get('volume', 0)
                    result.update({
                        # С префиксом ob_
                        'ob_buy_cluster': buy_cluster,
                        'ob_buy_cluster_price': buy_price,
                        'ob_buy_cluster_volume': buy_volume,
                        # Без префикса
                        'buy_cluster': buy_cluster,
                        'buy_cluster_price': buy_price,
                        'buy_cluster_volume': buy_volume
                    })

                if sell_cluster:
                    sell_price = sell_cluster.get('price', 0)
                    sell_volume = sell_cluster.get('volume', 0)
                    result.update({
                        # С префиксом ob_
                        'ob_sell_cluster': sell_cluster,
                        'ob_sell_cluster_price': sell_price,
                        'ob_sell_cluster_volume': sell_volume,
                        # Без префикса
                        'sell_cluster': sell_cluster,
                        'sell_cluster_price': sell_price,
                        'sell_cluster_volume': sell_volume
                    })

                return result

            except (IndexError, ValueError, TypeError) as e:
                logger.error(f"Ошибка при обработке стакана {pair}: {e}")
                return {}

        except Exception as e:
            logger.error(f"Критическая ошибка при анализе стакана {pair}: {e}", exc_info=True)
            return {}

    def populate_indicators(self, dataframe: DataFrame, metadata: dict) -> DataFrame:
        """Добавление индикаторов в датафрейм"""
        pair = metadata['pair']

        try:
            # Инициализируем колонки значениями по умолчанию
            default_columns = {
                # Основные колонки стакана (с префиксом ob_)
                'ob_buy_volume': 0.0,
                'ob_sell_volume': 0.0,
                'ob_buy_ratio': 0.0,
                'ob_sell_ratio': 0.0,
                'ob_best_bid': 0.0,
                'ob_best_ask': 0.0,
                'ob_spread': 0.0,
                'ob_mid_price': 0.0,
                'ob_timestamp': 0.0,
                'ob_buy_cluster': {},
                'ob_sell_cluster': {},
                'ob_buy_cluster_price': 0.0,
                'ob_buy_cluster_volume': 0.0,
                'ob_sell_cluster_price': 0.0,
                'ob_sell_cluster_volume': 0.0,

                # Колонки для кластерного анализа (без префикса)

            # Логируем сигналы
            self._log_signals(pair, dataframe, ob_analysis)
        else:
            logger.warning(f"Не удалось проанализировать стакан для {pair}")

    except Exception as e:
        logger.error(f"Ошибка в populate_indicators для {pair}: {e}")
        # В случае ошибки оставляем значения по умолчанию
        for col in default_columns:
            if col in dataframe.columns:
                dataframe[col] = default_columns[col]

    return dataframe

def _has_open_position(self, pair: str) -> bool:
    """Проверяет, есть ли открытая позиция по указанной паре"""
    try:
        open_positions = self.position_manager.get_open_positions(pair)
        return len(open_positions) > 0
    except Exception as e:
        logger.error(f"Ошибка при проверке открытой позиции для {pair}: {e}")
        return False
                logger.warning(f"Не удалось проанализировать стакан для {pair}")


