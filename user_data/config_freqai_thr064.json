{
  "$schema": "https://schema.freqtrade.io/schema.json",
  "max_open_trades": 3,
  "stake_currency": "USDT",
  "stake_amount": 100,
  "tradable_balance_ratio": 0.99,
  "fiat_display_currency": "USD",
  "dry_run": true,
  "dry_run_wallet": 1000,
  "cancel_open_orders_on_exit": false,
  "trading_mode": "futures",
  "margin_mode": "cross",
  "strategy": "FreqAICustomStrategy",
  "freqaimodel": "CatboostClassifierCustom",
  "timeframe": "5m",
  "unfilledtimeout": {
    "entry": 10,
    "exit": 10,
    "exit_timeout_count": 0,
    "unit": "minutes"
  },
  "entry_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1,
    "price_last_balance": 0.0,
    "check_depth_of_market": {
      "enabled": false,
      "bids_to_ask_delta": 1
    }
  },
  "exit_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1
  },
  "exchange": {
    "name": "binanceusdm",
    "key": "",
    "secret": "",
    "ccxt_config": {},
    "ccxt_async_config": {},
    "pair_whitelist": [
      "BTC/USDT:USDT",
      "ETH/USDT:USDT"
    ],
    "pair_blacklist": [
      "BNB/.*"
    ]
  },
  "pairlists": [
    {
      "method": "StaticPairList"
    }
  ],
  "freqai": {
    "enabled": true,
    "prediction_mode": "classification",
    "debug_skip_do_predict_gate": false,
    "purge_old_models": 2,
    "train_period_days": 20,
    "backtest_period_days": 5,
    "live_retrain_hours": 0,
    "expiration_hours": 1,
    "activate_tensorboard": false,
    "identifier": "clf_v1",
    "classifier": {
      "long_key": "1",
      "short_key": "0",
      "long_threshold": 0.64,
      "short_threshold": 0.64
    },
    "feature_parameters": {
      "include_timeframes": [
        "5m"
      ],
      "include_corr_pairlist": [],
      "label_period_candles": 12,
      "include_shifted_candles": 2,
      "DI_threshold": 0.9,
      "weight_factor": 0.9,
      "principal_component_analysis": false,
      "use_SVM_to_remove_outliers": false,
      "svm_params": {
        "shuffle": true,
        "nu": 0.1
      },
      "use_DBSCAN_to_remove_outliers": false,
      "indicator_max_period_candles": 20,
      "indicator_periods_candles": [
        10,
        20
      ]
    },
    "data_split_parameters": {
      "test_size": 0.33,
      "shuffle": false
    },
    "model_training_parameters": {
      "n_estimators": 800,
      "learning_rate": 0.05
    },
    "rl_config": {
      "train_cycles": 25,
      "add_state_info": true,
      "max_training_drawdown_pct": 0.02,
      "cpu_count": 8,
      "model_type": "PPO",
      "policy_type": "MlpPolicy",
      "model_reward_parameters": {
        "rr": 1,
        "profit_aim": 0.025,
        "win_reward_factor": 2
      }
    }
  },
  "telegram": {
    "enabled": false,
    "token": "",
    "chat_id": ""
  },
  "api_server": {
    "enabled": true,
    "listen_ip_address": "127.0.0.1",
    "listen_port": 8080,
    "verbosity": "error",
    "enable_openapi": false,
    "jwt_secret_key": "92858281c4e10f79442da2c20ebdc048036a089c8d032c00b8feadafbf9cfc2f",
    "ws_token": "hjkJcxQy4_BDMZ52hNEWQNQzUbrJWpIa2g",
    "CORS_origins": [],
    "username": "tanaka",
    "password": "Zensin4646"
  },
  "bot_name": "freqtrade",
  "initial_state": "running",
  "force_entry_enable": false,
  "internals": {
    "process_throttle_secs": 5
  },
  "ext_risk": {
    "vol_target": {
      "enabled": true,
      "mode": "unit_atr",
      "risk_pct_per_trade": 0.001,
      "atr_period": 14,
      "atr_k": 2.0,
      "max_leverage": 3,
      "edge_enabled": true,
      "edge_scale": 0.002,
      "edge_min": 0.75,
      "edge_max": 1.5
    },
    "tb": {
      "tp": 0.006,
      "sl": 0.006,
      "horizon_candles": 12
    },
    "calibration": {
      "enabled": true
    },
    "exit_policy": {
      "enabled": true,
      "time_stop_candles": 36,
      "partial_tps": [
        {
          "profit_pct": 0.003,
          "reduce_pct": 0.2,
          "min_hold_candles": 2
        },
        {
          "profit_pct": 0.006,
          "reduce_pct": 0.3,
          "min_hold_candles": 3
        },
        {
          "profit_pct": 0.01,
          "reduce_pct": 0.5,
          "min_hold_candles": 6
        }
      ],
      "trail_from_profit_pct": 0.008,
      "trail_step_pct": 0.004,
      "hard_stop_dd_pct": 0.015
    }
  }
}