# Orderbook collector environment overrides
OB_EXCHANGE=bybit
OB_PAIR=BTC/USDT:USDT
OB_DEPTH=200
OB_ROOT=/user_data/featurestore/bybit/BTCUSDT/1s
OB_SCHEMA_VER=1
OB_HEARTBEAT=15
OB_BACKOFF_BASE=3.0
OB_BATCH_SECONDS=60

# Bot Factory MVP services
BOT_FACTORY_POSTGRES_DB=bot_factory
BOT_FACTORY_POSTGRES_USER=bot_factory
BOT_FACTORY_POSTGRES_PASSWORD=bot_factory_dev_password
BOT_FACTORY_POSTGRES_PORT=5433
MLFLOW_IMAGE=ghcr.io/mlflow/mlflow:v2.17.2
MLFLOW_PORT=5000
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
