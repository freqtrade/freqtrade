FROM python:3.11-slim-bookworm

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONFAULTHANDLER=1 \
    PYTHONUNBUFFERED=1

WORKDIR /freqtrade

# System dependencies for pandas/pyarrow and friends
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential libssl-dev libffi-dev \
       libgomp1 libatlas3-base curl pkg-config cmake git \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Python dependencies required by tools/ob_collector_ws.py
COPY docker/requirements-ob-collector.txt /tmp/requirements.txt
RUN pip install --upgrade pip wheel \
    && pip install --no-cache-dir -r /tmp/requirements.txt

# Copy source tree (WS collector + utilities)
COPY . /freqtrade

ENTRYPOINT ["python", "tools/ob_collector_ws.py"]
